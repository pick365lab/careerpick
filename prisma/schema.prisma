generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model GenerationLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  resume    String   @db.Text
  jd        String   @db.Text
  format    String
  tone      String
  result    String   @db.Text
  feedback  String?  // 'like' | 'dislike'
}
